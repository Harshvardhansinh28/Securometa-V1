APP_NAME=Unified SOC Platform
APP_ENV=dev
APP_DEBUG=true

API_V1_PREFIX=/api/v1

DATABASE_URL=mysql+pymysql://soc_user:CHANGE_ME@127.0.0.1:3306/soc_platform?charset=utf8mb4

REDPANDA_BOOTSTRAP_SERVERS=127.0.0.1:9092
REDPANDA_ENABLED=true

SECEON_BASE_URL=https://your-seceon-api-url
SECEON_TOKEN=CHANGE_ME
SECEON_VERIFY_TLS=true
SECEON_CA_BUNDLE=

SECURONIX_BASE_URL=https://your-securonix-url
SECURONIX_TOKEN=CHANGE_ME
SECURONIX_COOKIE=CHANGE_ME
SECURONIX_VERIFY_TLS=true
SECURONIX_CA_BUNDLE=

CONNECTOR_TIMEOUT_SECONDS=60
CONNECTOR_MAX_WORKERS=5